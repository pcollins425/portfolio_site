# Docker Compose variable substitution — place this file at the REPO ROOT:
#   portfolio_site/.env   (same folder as docker-compose.yml)
#
# NOT backend_live/.env — compose does not read that file for volume paths.
#
# Optional if cursor-assistant is a sibling folder (../cursor-assistant):
# ASSISTANT_WORKSPACE_HOST=../cursor-assistant
#
# WSL bash:
# ASSISTANT_WORKSPACE_HOST="/mnt/c/Users/DGS Slot Server/cursor-assistant"
#
# Windows PowerShell / Docker Desktop:
# ASSISTANT_WORKSPACE_HOST=C:/Users/DGS Slot Server/cursor-assistant
