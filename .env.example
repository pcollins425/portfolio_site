# Docker Compose variable substitution (repo root).
# Copy to .env and edit — .env is gitignored.
#
# Host path to the cursor-assistant clone, as seen by the process that runs
# `docker compose` (usually WSL on the SQL server).
#
# WSL (typical when compose runs from bash on the server):
ASSISTANT_WORKSPACE_HOST=/mnt/c/Users/DGS Slot Server/cursor-assistant
#
# Native Windows PowerShell / Docker Desktop only (not WSL bash):
# ASSISTANT_WORKSPACE_HOST=C:/Users/DGS Slot Server/cursor-assistant
