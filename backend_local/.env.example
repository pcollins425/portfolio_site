API_HOST=127.0.0.1
API_PORT=9002

API_RELOAD=true

# Optional: load MSSQL_* from another file first (e.g. USB credential bundle).
# MASTER_CREDENTIALS_ENV=/path/to/.env

# Application DB catalog where **[dashboard].[vw_performance_report]** lives.
MSSQL_DATABASE=dgs_application_db
MSSQL_HOST=
# MSSQL_EXTERNAL=192.168.1.195
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=

# Field / scanner routes — `dgs_field_api` (optional locally; falls back to MSSQL_USER).
MSSQL_FIELD_USER=
MSSQL_FIELD_PASSWORD=

# eMaint Record API (asset prep status writes from demo scan flow)
EMAINT_SERVER_URL=
EMAINT_LOGIN_URL=
EMAINT_USER=
EMAINT_PASSWORD=
EMAINT_USER_AGENT=PAUL_v1

# eMaint demo auth — set EMAINT_DEMO_AUTH_REQUIRED=false for local browse without Google.
EMAINT_DEMO_AUTH_REQUIRED=false
EMAINT_DEMO_ALLOWED_EMAIL_DOMAIN=dynamicgamingsolutions.com
EMAINT_DEMO_JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAINT_DEMO_OAUTH_REDIRECT_URI=http://127.0.0.1:9002/api/auth/google/callback
# When set, local run.py prefers this callback + allows localhost return URLs.
EMAINT_DEMO_OAUTH_REDIRECT_URI_LOCAL=http://127.0.0.1:9002/api/auth/google/callback
EMAINT_DEMO_FRONTEND_ORIGIN_LOCAL=http://localhost:8080
# Static server runs from dgsappv1/ — no /dgsappv1 prefix locally (live uses /dgsappv1).
EMAINT_DEMO_FRONTEND_APP_PATH=/

# Assistant module — Cursor SDK local runtime against a workspace clone
# ASSISTANT_WORKSPACE=E:/cursor-assistant
# ASSISTANT_SESSIONS_FILE=
# ASSISTANT_MODEL=composer-2.5
# CURSOR_API_KEY=cursor_...

# Parts catalog photos + Stripe sandbox (GET /api/parts-catalog/checkout-config)
# PARTS_PHOTOS_ROOT=/tmp/parts_photos
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Vendor logos / cabinet images (contracts-v2 media card)
# Windows: Z:\Paul Collins\tableau images
# WSL:    /mnt/z/Paul Collins/tableau images
# MEDIA_ROOT=Z:\Paul Collins\tableau images

# Parts catalog customer accounts + Stripe Tax
# PARTS_CUSTOMER_JWT_SECRET=
# PARTS_STAFF_TOKEN=
# STRIPE_TAX_CODE=txcd_99999999
# PARTS_EXEMPTION_UPLOAD_ROOT=/tmp/parts_exemption_certs
