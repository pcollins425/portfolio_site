API_HOST=127.0.0.1
API_PORT=9001

API_RELOAD=false

# Optional: load MSSQL_* from another file first.
# MASTER_CREDENTIALS_ENV=/path/to/.env

MSSQL_DATABASE=dgs_application_db
MSSQL_HOST=
# MSSQL_EXTERNAL=192.168.1.195
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=

# Field / scanner routes (`/api/asset/lookup`, `/api/field/health`) — `dgs_field_api`.
# Dashboard routes keep using MSSQL_USER (`dashboard_perf_ro`).
MSSQL_FIELD_USER=
MSSQL_FIELD_PASSWORD=

# eMaint Record API (asset prep status writes from demo scan flow)
EMAINT_SERVER_URL=
EMAINT_LOGIN_URL=
EMAINT_USER=
EMAINT_PASSWORD=
EMAINT_USER_AGENT=PAUL_v1

# eMaint demo — Google Workspace sign-in + per-table RBAC (employees.*)
EMAINT_DEMO_AUTH_REQUIRED=true
EMAINT_DEMO_ALLOWED_EMAIL_DOMAIN=dynamicgamingsolutions.com
EMAINT_DEMO_JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAINT_DEMO_OAUTH_REDIRECT_URI=https://api.collinsmediallc.com/api/auth/google/callback
EMAINT_DEMO_FRONTEND_ORIGIN=https://www.collinsmediallc.com
# Do not set *_LOCAL vars here — those are for backend_local (port 9002) only.

# Assistant module — Cursor SDK local runtime
#
# Docker: workspace mount defaults to sibling ../cursor_assistant.
# Folder name varies (cursor_assistant vs cursor-assistant) — set ASSISTANT_WORKSPACE_HOST
# to the absolute host path, then:
#   docker compose --env-file backend_live/.env up -d --build
#
#   PowerShell:  ASSISTANT_WORKSPACE_HOST=C:/Users/DGS Slot Server/cursor-assistant
#   WSL bash:    ASSISTANT_WORKSPACE_HOST=/mnt/c/Users/DGS\ Slot\ Server/cursor-assistant
#   Paul WSL:    ASSISTANT_WORKSPACE_HOST=/mnt/c/users/Paul\ Collins/cursor_assistant
#
# Sparse clone on the host? The assistant only sees checked-out paths. Expand first, e.g.:
#   git sparse-checkout set deploy/work_orders agents .cursor data scripts sessions
# FSR Apply also needs scripts/fsr_intake in that checkout (not sparse-excluded).
#
# Required on DGS Slot Server for FSR Apply (compose volume mount):
# ASSISTANT_WORKSPACE_HOST=C:/Users/DGS Slot Server/cursor-assistant
# ASSISTANT_SESSIONS_FILE=
# ASSISTANT_SETTING_SOURCES=project
#   Comma-separated Cursor setting sources (project, user, team, all). Default: project (.cursor/rules).
# ASSISTANT_AGENT_STORE_DIR=
#   Persist SDK agent state for resume across container restarts (default: beside sessions file).
#
# Cursor user or team service-account key (Dashboard → Integrations). Required for chat.
# CURSOR_API_KEY=cursor_...
#
# FSR review Apply (POST /api/fsr-review/cases/{id}/apply) — runs scripts.fsr_intake.apply_from_review
# inside the API container against the mounted checkout.
# FSR_APPLY_ROOT=/workspace
# FSR_APPLY_LIVE=1
#   Required for "Apply live" (dry-run works without this). Recreate container after setting.
# FSR_APPLY_TIMEOUT_SEC=600
#
# Workbook fetch uses Gmail unless a cached .xlsx is already under data/fsr_*.
# Provide GMAIL_REFRESH_TOKEN + GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET (or MASTER_CREDENTIALS_ENV
# that defines them), same as other Gmail tooling.

# Vendor logos / cabinet images (Contracts v2 — GET /api/media/*)
#
# --- Preferred on DGS Slot Server: direct SMB read (no mount, no sync) ---
# New PNGs on NAS are visible immediately after DB path update.
#
# NAS_MEDIA_MODE=smb
# NAS_MEDIA_SHARE=//192.168.1.99/DGS_Analytics
# NAS_MEDIA_SUBPATH=Paul Collins/tableau images
# NAS_MEDIA_USERNAME=
# NAS_MEDIA_PASSWORD=
# MEDIA_HEALTH_PROBE=logos/logo_AGS.png
#
# --- Contract PDFs (Contracts v2 — GET /api/documents/*, POST upload) ---
# Same SMB share/credentials as media; different subpath.
#
# NAS_DOCS_SUBPATH=Paul Collins/contract documents
# NAS_DOCS_MODE=smb
# DOCS_HEALTH_PROBE=agreements/AGS/example.pdf
#
# Local dev (Z: mounted):
# DOCS_ROOT=Z:\Paul Collins\contract documents
# NAS_MEDIA_MODE=wsl
# NAS_MEDIA_WSL_BIND=//wsl.localhost/Ubuntu/mnt/dgs-nas-media
# scripts\mount_nas_media_wsl.cmd before compose up
#
# --- Fallback: local mirror (dev) ---
# MEDIA_ROOT_HOST=C:/Users/DGS Slot Server/portfolio_media/tableau-images
# MEDIA_ROOT=/media/tableau-images
